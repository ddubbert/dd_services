# Copy to .env and fill in. Never commit .env.
ACCESS_KEY_PASSPHRASE=<access_key_passphrase>
REFRESH_KEY_PASSPHRASE=<refresh_key_passphrase>

DATABASE_HOST=<database_host>
DATABASE_PORT=<database_port>
REPLICA_SET_NAME=<replica_set_name>
ADMIN_USERNAME=<admin_username>
ADMIN_PASSWORD=<admin_password>
ROOT_DATABASE_NAME=<root_database_name>

BACKUP_DATABASE_1_HOST=<backup_database_1_host>
BACKUP_DATABASE_2_HOST=<backup_database_2_host>

GATEWAY_HOST=<gateway_host>
GATEWAY_PORT=<gateway_port>
GATEWAY_BEARER_TOKEN=<gateway_bearer_token>

USERS_HOST=<users_host>
USERS_PORT=<users_port>
# USERS_DATABASE_NAME=<users_database_name>
USERS_DATABASE_USER=<users_database_user>
USERS_DATABASE_PASSWORD=<users_database_password>
ACCESS_TOKEN_TTL=<access_token_ttl>
REFRESH_TOKEN_TTL=<refresh_token_ttl>

MAX_FILE_UPLOAD_AMOUNT=<max_file_upload_amount>
MAX_FILE_SIZE=<max_file_size>
MAX_SESSION_UPLOAD_SPACE_IN_BYTE=<max_session_upload_space_in_byte>
MAX_USER_UPLOAD_SPACE_IN_BYTE=<max_user_upload_space_in_byte>
FILES_HOST=<files_host>
FILES_PORT=<files_port>
# FILES_DATABASE_NAME=<files_database_name>
FILES_DATABASE_USER=<files_database_user>
FILES_DATABASE_PASSWORD=<files_database_password>

FILES_UPLOAD_HOST=<files_upload_host>
FILES_UPLOAD_PORT=<files_upload_port>
UPLOAD_LINK_TTL=<upload_link_ttl>

SESSIONS_HOST=<sessions_host>
SESSIONS_PORT=<sessions_port>
# SESSIONS_DATABASE_NAME=<sessions_database_name>
SESSIONS_DATABASE_USER=<sessions_database_user>
SESSIONS_DATABASE_PASSWORD=<sessions_database_password>

SUBSCRIPTIONS_HOST=<subscriptions_host>
SUBSCRIPTIONS_PORT=<subscriptions_port>
# SUBSCRIPTIONS_DATABASE_NAME=<subscriptions_database_name>
SUBSCRIPTIONS_DATABASE_USER=<subscriptions_database_user>
SUBSCRIPTIONS_DATABASE_PASSWORD=<subscriptions_database_password>

CACHE_HOST=<cache_host>
CACHE_PORT=<cache_port>
CACHE_PASSWORD=<cache_password>

# --- Keycloak / Postman test values (fill in locally) ---
# Keycloak client secret, realm DD_SERVICES (also in users/keycloak.json)
KEYCLOAK_DD_SERVICES_CLIENT_SECRET=<keycloak_dd_services_client_secret>
# Keycloak client secret, realm HybridLR, client "mixmonster" (was sessions/keycloak.json)
KEYCLOAK_HYBRIDLR_MIXMONSTER_CLIENT_SECRET=<keycloak_hybridlr_mixmonster_client_secret>
# Postman collection: keycloakSecret/secret variables and the test login
POSTMAN_TEST_USERNAME=<postman_test_username>
POSTMAN_TEST_PASSWORD=<postman_test_password>
# Postman collection variable "auth" (old bearer token signed with the local access key)
POSTMAN_AUTH_TOKEN=<postman_auth_token>
